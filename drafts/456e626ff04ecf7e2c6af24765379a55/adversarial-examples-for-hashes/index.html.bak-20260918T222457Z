<span class="code-line" id="code-highway-17"><span aria-hidden="true" class="line-number">17</span>        mul1[i] ^= (v0[i] &amp; 0xffffffff) * (v1[i] &gt;&gt; 32);</span>
<span class="code-line" id="code-highway-18"><span aria-hidden="true" class="line-number">18</span>    }</span>
