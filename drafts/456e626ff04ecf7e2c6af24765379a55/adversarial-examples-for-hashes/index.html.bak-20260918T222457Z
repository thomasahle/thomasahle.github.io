<text fill="currentColor" font-size="12" stroke="none" text-anchor="middle" x="273.0" y="686.0">kMul · public</text>
<path d="M 274.00 695.00 L 274.00 706.00" data-edge-label="×" fill="none" marker-end="url(#arrow-farmhash64)" stroke="currentColor" stroke-width="1.25"></path>
