<span class="code-line" id="code-highway-5"><span aria-hidden="true" class="line-number">05</span>        0xbe5466cf34e90c6c, 0x452821e638d01377};</span>
<span class="code-line" id="code-highway-6"><span aria-hidden="true" class="line-number">06</span>for (i = 0; i &lt; 4; ++i) { v0[i] = mul0[i] ^ key[i]; v1[i] = mul1[i] ^ rotl(key[i],32); }</span>
<span class="code-line" id="code-highway-7"><span aria-hidden="true" class="line-number">07</span>pair zipper(u64 a, u64 b) {          // Public byte permutation, a = low lane.</span>
<span class="code-line" id="code-highway-8"><span aria-hidden="true" class="line-number">08</span>    bytes = little_endian_bytes(words(a,b));</span>
<span class="code-line" id="code-highway-9"><span aria-hidden="true" class="line-number">09</span>    return (pack_le(bytes, {3,12,2,5,14,1,15,0}),</span>
<span class="code-line" id="code-highway-10"><span aria-hidden="true" class="line-number">10</span>            pack_le(bytes, {11,4,10,13,9,6,8,7}));</span>
